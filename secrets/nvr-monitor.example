{
  "mode": "local",
  "expected": ["cam1_mensroom", "cam2_living", "cam3_kitchen", "cam4_hallway", "cam5_laundry"],
  "excluded": {"cam6_extra": "Intentionally unplugged; re-enable when returned to service"},
  "api_url": "http://127.0.0.1:5000",
  "recording_root": "D:/frigate/media/recordings",
  "disk_path": "D:/",
  "min_free_gib": 30,
  "lan_gateway": "192.168.3.1",
  "expected_lan_ip": "REPLACE_WITH_RESERVED_NVR_IP",
  "state_dir": "D:/YOUR_DEPLOYMENT/runtime/monitor/state",
  "distro": "Ubuntu",
  "wsl_repo": "/mnt/d/YOUR_DEPLOYMENT",
  "recovery_enabled": false,
  "allow_wsl_reset": false,
  "heartbeat_ssh": {
    "destination": "nvr-observer@YOUR_VPS",
    "key": "D:/YOUR_DEPLOYMENT/runtime/monitor/heartbeat_ed25519",
    "known_hosts": "D:/YOUR_DEPLOYMENT/runtime/monitor/known_hosts"
  }
}
