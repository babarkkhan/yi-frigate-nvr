# Copy to frigate.env and fill in. frigate.env is gitignored.
# The cameras have no RTSP auth configured, so this is unused for now -
# it exists so credentials never end up in config.yml if that changes.
FRIGATE_RTSP_PASSWORD=unused
# Generate a private 64-character hex value and share it only with the gateway.
# Required by the Google camera gateway configuration. Never commit the value.
FRIGATE_PROXY_SECRET=REPLACE_WITH_RANDOM_SECRET
