# Copy to tailscale.env (gitignored) and paste a key from:
#   https://login.tailscale.com/admin/settings/keys
#
# Generate a REUSABLE + EPHEMERAL=false auth key. Tick "Pre-approved" if your
# tailnet requires device approval, otherwise approve it in the admin console
# after first connect.
TS_AUTHKEY=tskey-auth-REPLACE-ME
